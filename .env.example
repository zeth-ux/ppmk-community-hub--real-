# Copy this file to .env.local and fill in the values from
# Supabase dashboard -> Project Settings -> API (or "API Keys").
# Both values are safe to expose in the browser. NEVER put the
# service_role / secret key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=paste-your-anon-or-publishable-key-here
