{
  "name": "ppmk-community-hub",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "demo": "vite --mode demo --open",
    "build:demo": "vite build --mode demo --outDir dist-demo",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test:ai": "tsx --test tests/ai.test.ts",
    "test:db": "python3 supabase/tests/test_rls.py",
    "ai:eval": "tsx --env-file=.env.local scripts/ai-eval/run.ts",
    "test:reminders": "tsx --test tests/reminders.test.ts",
    "reminders:secret": "tsx scripts/reminder-secret.ts",
    "reminders:preview": "tsx scripts/reminder-preview.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.52.0",
    "nodemailer": "10.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
